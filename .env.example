# Supabase project settings — Project Settings → API in the Supabase dashboard.
# The anon key is safe to expose in the browser; Row Level Security is what
# protects the data (see supabase/migrations/0001_create_enrollments.sql).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
